{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ago/logo-grid",
    "title": "Cuadrícula de logos",
    "category": "ago",
    "icon": "grid-view",
    "description": "Logos en cuadrícula: N por fila, los que sobran bajan a la siguiente fila. Enlace opcional por logo.",
    "textdomain": "ago",
    "supports": {
        "html": false
    },
    "attributes": {
        "logos":   { "type": "array",  "default": [] },
        "columns": { "type": "number", "default": 3 }
    },
    "render": "file:./render.php"
}
