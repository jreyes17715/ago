{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ago/point-list",
    "title": "Lista con puntos",
    "category": "ago",
    "icon": "editor-ul",
    "description": "Título + puntos con círculo conectados por una línea vertical, en 1 o 2 columnas.",
    "textdomain": "ago",
    "supports": {
        "html": false
    },
    "attributes": {
        "title":   { "type": "string", "default": "" },
        "items":   { "type": "array",  "default": [ "", "", "" ] },
        "columns": { "type": "number", "default": 2 }
    },
    "render": "file:./render.php"
}
