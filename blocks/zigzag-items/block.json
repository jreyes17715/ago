{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ago/zigzag-items",
    "title": "Pilares en zigzag",
    "category": "ago",
    "icon": "editor-insertmore",
    "description": "Ítems con ícono en círculo + número automático, título y contenido. Impares: imagen arriba; pares: imagen abajo.",
    "textdomain": "ago",
    "supports": {
        "html": false
    },
    "attributes": {
        "items": {
            "type": "array",
            "default": [
                { "imageId": 0, "title": "", "content": "" },
                { "imageId": 0, "title": "", "content": "" },
                { "imageId": 0, "title": "", "content": "" },
                { "imageId": 0, "title": "", "content": "" }
            ]
        },
        "columns": { "type": "number", "default": 4 }
    },
    "render": "file:./render.php"
}
